# PASSWORD=S@draAfzar

DB_SERVER=192.168.1.11\sqlsadra
DB_NAME=DBSadraafzar001
USERNAME=AI
PASSWORD=S@dra123

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Demand-driven processing configuration
PROCESSING_MODE=demand_driven

# Frame extraction settings
FRAME_EXTRACTION_TIMEOUT=10
FRAME_CACHE_EXPIRE=30
MAX_EXTRACTION_RETRIES=3

# Production monitoring
PRODUCTION_IDLE_THRESHOLD=30.0
PRODUCTION_SPEED_MONITOR=true

# Camera connection
CAMERA_RECONNECT_INTERVAL=10.0
CAMERA_CONNECTION_TIMEOUT=15.0
MAX_RECONNECT_ATTEMPTS=5

# System monitoring
HEALTH_CHECK_INTERVAL=60.0
PERFORMANCE_METRICS_WINDOW=100
ENABLE_SYSTEM_MONITORING=true

# AI processing
AI_CONFIDENCE_THRESHOLD=0.7
AI_INFERENCE_TIMEOUT=5.0
ENABLE_AI_CONFIDENCE_LOGGING=true

# Database sync
DB_SYNC_BATCH_SIZE=100
DB_SYNC_RETRY_ATTEMPTS=3
DB_CONNECTION_POOL_SIZE=5

# Logging
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
LOG_FILE_ROTATION=true
MAX_LOG_FILE_SIZE=100MB
LOG_RETENTION_DAYS=30